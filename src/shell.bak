<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="color-scheme" content="only light">
<title>FIZZ RIOT — Sparkling Soda</title>
<meta name="description" content="FIZZ RIOT: four flavours of sparkling soda that won't sit still. Watermelon & Mint, Mango & Chili, Blueberry & Lavender, Lime & Ginger.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;600&family=Rubik+Mono+One&display=swap" rel="stylesheet">
<script>document.documentElement.classList.add('js');</script>
<style>
:root{
  --cream:#FFF3E2; --cream2:#FBE6CC; --ink:#1A0F2E;
  --f1:#E5618A; --f1d:#B84261; --f2:#EBC867; --f2d:#D9A93E; --f3:#6C3DAA; --f3d:#47287B; --f4:#AACA36; --f4d:#789D1B;
  --expo:cubic-bezier(.16,1,.3,1); --quint:cubic-bezier(.22,1,.36,1);
  --u:clamp(10px,1vw,16px);
  --disp:'Rubik Mono One',system-ui,sans-serif; --ui:'Familjen Grotesk',system-ui,sans-serif;
  --tx:var(--ink);
}
@media (prefers-color-scheme:dark){:root{--cream:#FFF3E2;--ink:#1A0F2E}html,body{background:#FFF3E2;color:#1A0F2E}}
*{box-sizing:border-box;margin:0;padding:0}
html,body{overflow-x:clip;background:var(--cream);color:var(--ink)}
body{font-family:var(--ui);font-size:16px;line-height:1.45;-webkit-font-smoothing:antialiased}
img{display:block;max-width:none}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px;border-radius:6px}

/* ---------- preloader ---------- */
.pre{position:fixed;inset:0;z-index:100;background:var(--cream);overflow:hidden;pointer-events:auto}
.pre .liq{position:absolute;inset:0;background:var(--f1);transition:background-color .5s}
.pre .num{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-family:var(--disp);font-size:min(22vw,220px);color:var(--ink);white-space:nowrap;mix-blend-mode:multiply;letter-spacing:-.04em}
.pre .lab{position:absolute;left:0;right:0;bottom:6vh;text-align:center;font-weight:600;letter-spacing:.24em;font-size:12px;text-transform:uppercase}
.pre.done{pointer-events:none}

/* ---------- nav ---------- */
.nav{position:fixed;left:0;right:0;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:18px clamp(16px,3vw,40px);color:var(--tx);transition:color .4s;pointer-events:none}
.nav>*{pointer-events:auto}
.logo{font-family:var(--disp);font-size:15px;letter-spacing:.02em;display:flex;gap:.5em;align-items:center}
.logo i{display:inline-flex;gap:3px}.logo i b{width:7px;height:7px;border-radius:50%;display:block}
.nav ul{display:flex;gap:28px;list-style:none;font-weight:600;font-size:14px}
.nav ul a{position:relative}.nav ul a::after{content:"";position:absolute;left:0;right:0;bottom:-3px;height:2px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .45s var(--expo)}
.nav ul a:hover::after{transform:scaleX(1)}
.nav.inv{color:var(--cream)!important}
.chip{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;border:1.5px solid currentColor;border-radius:99px;padding:7px 14px}

/* ---------- hero playground ---------- */
.hero{position:relative;height:100vh;height:100svh;min-height:560px;overflow:hidden;background:
  radial-gradient(40vw 40vw at 8% 12%,rgba(229,97,138,.22),transparent 70%),
  radial-gradient(38vw 38vw at 92% 18%,rgba(235,200,103,.32),transparent 70%),
  radial-gradient(44vw 44vw at 85% 105%,rgba(108,61,170,.16),transparent 70%),
  radial-gradient(40vw 40vw at 10% 100%,rgba(170,202,54,.24),transparent 70%),var(--cream)}
.world{position:absolute;inset:0;cursor:grab;touch-action:pan-y}
.world:active{cursor:grabbing}
.it{position:absolute;left:0;top:0;will-change:transform;pointer-events:none;user-select:none;-webkit-user-select:none}
.ltr{z-index:2;font-family:var(--disp);line-height:1;text-align:center;display:flex;align-items:center;justify-content:center;text-shadow:0 .045em 0 rgba(26,15,46,.16)}
.it.can{filter:drop-shadow(0 18px 18px rgba(26,15,46,.22))}
.it.pc{filter:drop-shadow(0 8px 8px rgba(26,15,46,.18))}
#fx{position:absolute;inset:0;pointer-events:none;z-index:3}
.hero-copy{position:absolute;z-index:4;left:clamp(16px,3vw,40px);right:clamp(16px,3vw,40px);top:calc(70px + 2vh);display:flex;justify-content:space-between;align-items:flex-start;gap:24px;pointer-events:none}
.hero-copy p{max-width:25ch;font-size:clamp(17px,1.5vw,22px);line-height:1.25;font-weight:600}
.hero-copy p em{font-style:normal;background:var(--ink);color:var(--cream);padding:0 .25em;border-radius:.2em}
.eyebrow{display:block;font-size:11px;letter-spacing:.26em;text-transform:uppercase;margin-bottom:12px;opacity:.6;font-weight:600}
.hint{display:flex;flex-direction:column;align-items:flex-end;gap:8px;font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase}
.hint span{display:flex;align-items:center;gap:10px}
.hint span b{width:20px;height:20px;border-radius:50%;border:1.5px solid var(--ink);display:inline-grid;place-items:center;font-size:10px}
.anim .hero-copy>*{opacity:0;transform:translateY(24px)}
.play .hero-copy>*{opacity:1;transform:none;transition:opacity .9s var(--expo),transform .9s var(--expo)}
.play .hero-copy>*:nth-child(2){transition-delay:.12s}

/* ---------- flavour story ---------- */
.story{position:relative;height:920vh;background:var(--f1)}
.stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}
.fl{position:absolute;inset:0;overflow:hidden;background:radial-gradient(120% 90% at 50% 45%,var(--c) 40%,var(--cd) 100%);color:var(--t);visibility:hidden}
.fl.vis{visibility:visible}
.fl .bub{position:absolute;bottom:-40px;border-radius:50%;border:1.5px solid rgba(255,255,255,.55);background:radial-gradient(circle at 32% 30%,rgba(255,255,255,.7),rgba(255,255,255,.08) 45%,transparent 60%);animation:rise var(--d) linear infinite;animation-delay:var(--dl)}
@keyframes rise{from{transform:translate3d(0,0,0)}50%{transform:translate3d(var(--sw),-55vh,0)}to{transform:translate3d(0,-115vh,0)}}
.fl .glow{position:absolute;left:12%;top:12%;width:44vw;height:44vw;max-width:720px;max-height:720px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.42),transparent 65%)}
.canwrap{position:absolute;left:30%;top:50%;width:0;height:0;will-change:transform}
.canbox{position:absolute;height:min(76vh,720px);aspect-ratio:400/920;left:0;top:0;transform:translate(-50%,-50%);filter:drop-shadow(0 40px 40px rgba(0,0,0,.25))}
.canbox video,.canbox canvas,.canbox img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
.canbox .still{transition:opacity .3s}.canbox.live .still{opacity:0}
.fp{position:absolute;will-change:transform;pointer-events:none;filter:drop-shadow(0 14px 14px rgba(0,0,0,.2))}
.txt{position:absolute;left:54%;right:6vw;top:50%;transform:translateY(-50%);will-change:transform,opacity}
.idx{display:flex;gap:14px;align-items:center;font-weight:600;font-size:13px;letter-spacing:.22em;text-transform:uppercase;margin-bottom:2.2vh}
.idx i{display:block;width:44px;height:2px;background:currentColor}
.nm{font-family:var(--disp);font-size:clamp(46px,7.4vw,128px);line-height:.9;letter-spacing:-.02em}
.nm .ln{display:block;white-space:nowrap}
.nm .ch{display:inline-block;will-change:transform}
.sub{font-family:var(--disp);font-size:clamp(18px,2.1vw,34px);margin-top:1.4vh;opacity:.9}
.note{max-width:32ch;font-size:clamp(16px,1.25vw,19px);font-weight:600;margin-top:2.6vh;line-height:1.35}
.meters{display:grid;gap:10px;margin-top:3.2vh;max-width:330px}
.meter{display:grid;grid-template-columns:70px 1fr;align-items:center;font-size:11px;font-weight:600;letter-spacing:.2em}
.dots{display:flex;gap:7px}.dots b{width:18px;height:18px;border-radius:50%;border:2px solid currentColor;transform:scale(.6);opacity:.35;transition:transform .5s var(--expo),opacity .4s,background-color .3s}
.dots b.on{transform:scale(1);opacity:1;background:currentColor}
.splash{position:absolute;inset:0;width:100%;height:100%;opacity:0;pointer-events:none}
.popw{position:absolute;left:50%;top:50%;font-family:var(--disp);font-size:clamp(70px,15vw,260px);color:#fff;white-space:nowrap;transform:translate(-50%,-50%) scale(0);pointer-events:none;letter-spacing:-.03em;-webkit-text-stroke:0;text-shadow:0 .05em 0 rgba(0,0,0,.18),0 0 60px rgba(0,0,0,.15)}
.cap{position:absolute;left:clamp(16px,3vw,40px);bottom:4.5vh;font-weight:600;font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:#fff;opacity:0;text-shadow:0 1px 10px rgba(0,0,0,.3)}
.rail{position:absolute;right:clamp(14px,2.4vw,34px);top:50%;transform:translateY(-50%);z-index:20;display:grid;gap:14px}
.rail button{display:flex;align-items:center;justify-content:flex-end;gap:10px;font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--tx);transition:color .4s}
.rail button span{opacity:0;transform:translateX(8px);transition:opacity .35s,transform .45s var(--expo)}
.rail button:hover span,.rail button.on span{opacity:1;transform:none}
.rail button b{width:12px;height:12px;border-radius:50%;border:2px solid currentColor;transition:background-color .3s,transform .4s var(--expo)}
.rail button.on b{background:currentColor;transform:scale(1.25)}

/* ---------- vending machine ---------- */
.pack{position:relative;height:100vh;height:100svh;min-height:760px;overflow:hidden;--g:#E5618A;background:var(--g);transition:background-color .7s;color:var(--ink)}
.pack .wall{position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,.07) 0 2px,transparent 2px 120px),radial-gradient(70% 60% at 50% 40%,rgba(255,255,255,.35),transparent 70%)}
.pack .floor{position:absolute;left:0;right:0;bottom:0;height:16%;background:linear-gradient(180deg,rgba(0,0,0,.14),rgba(0,0,0,.04) 30%,rgba(255,255,255,.08))}
.pack .head{position:absolute;z-index:6;left:clamp(16px,3vw,40px);top:clamp(84px,13vh,130px);max-width:30vw;pointer-events:none}
.pack h2{font-family:var(--disp);font-size:clamp(36px,4.6vw,80px);line-height:.92;letter-spacing:-.02em;color:var(--ink)}
.pack h2 span{display:block}.pack h2 span:last-child{color:#fff;text-shadow:0 .05em 0 rgba(26,15,46,.18)}
.pack .lead{margin-top:2.4vh;max-width:24ch;font-size:clamp(15px,1.2vw,18px);font-weight:600}
.pack .tag{position:absolute;z-index:6;right:clamp(16px,3vw,40px);top:clamp(84px,13vh,130px);text-align:right;font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;line-height:2}
.pack .tag b{display:block;font-family:var(--disp);font-size:clamp(28px,3vw,46px);letter-spacing:0;line-height:1.1}
.vm{position:absolute;z-index:3;left:54%;bottom:9%;width:min(520px,88vw);height:min(80vh,760px);transform:translateX(-50%);display:grid;grid-template-columns:1fr 30%;grid-template-rows:auto 1fr 17%;border-radius:34px 34px 18px 18px;background:linear-gradient(100deg,#2A1B48 0%,#1A0F2E 38%,#120A22 100%);box-shadow:inset 0 2px 0 rgba(255,255,255,.18),inset 6px 0 0 rgba(255,255,255,.05),0 50px 70px -30px rgba(26,15,46,.65);padding:16px;transform-origin:50% 100%}
.vm::after{content:"";position:absolute;left:8%;right:8%;bottom:-22px;height:22px;border-radius:50%;background:radial-gradient(closest-side,rgba(26,15,46,.45),transparent);z-index:-1}
.vm-sign{grid-column:1/3;display:flex;align-items:center;justify-content:space-between;padding:6px 10px 14px;font-family:var(--disp);font-size:clamp(18px,2vw,28px);color:#fff;letter-spacing:.02em}
.vm-sign i{font-style:normal;color:var(--g);text-shadow:0 0 14px var(--g),0 0 2px #fff;transition:color .5s}
.vm-sign .neon{color:#fff;text-shadow:0 0 6px rgba(255,255,255,.9),0 0 22px var(--g),0 0 40px var(--g);animation:flick 4s steps(1) infinite}
@keyframes flick{0%,92%,94%,97%,100%{opacity:1}93%{opacity:.55}96%{opacity:.7}}
.vm-win{position:relative;border-radius:16px;overflow:hidden;background:linear-gradient(180deg,#FFF6EA,#F2DFC6);box-shadow:inset 0 0 0 3px rgba(0,0,0,.35),inset 0 10px 20px rgba(0,0,0,.18);display:grid;grid-template-rows:repeat(3,minmax(0,1fr));padding:10px 8px 0;min-height:0}
.vm-win::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,rgba(255,255,255,.55) 0 8%,transparent 8% 22%,rgba(255,255,255,.25) 22% 25%,transparent 25%);pointer-events:none;z-index:3}
.vrow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));min-height:0;border-bottom:6px solid #CDB9A0;box-shadow:0 3px 0 rgba(0,0,0,.12);position:relative}
.slot{position:relative;min-height:0}
.slot .cn{position:absolute;left:0;right:0;top:4%;bottom:10%;display:flex;align-items:flex-end;justify-content:center}
.slot img{height:100%;width:auto;max-width:96%;object-fit:contain;filter:drop-shadow(0 6px 6px rgba(0,0,0,.28));will-change:transform;position:relative;z-index:1}
.slot .coil{position:absolute;left:12%;right:12%;bottom:0;height:14%;border-radius:4px;background:repeating-linear-gradient(100deg,#9A9AA6 0 3px,#E4E4EC 3px 5px,transparent 5px 11px);z-index:2}
.slot .coil.spin{animation:coil .5s linear 1}
@keyframes coil{to{background-position:44px 0}}
.vm-side{grid-row:2/4;grid-column:2;display:flex;flex-direction:column;align-items:center;gap:12px;padding:6px 0 6px 14px}
.led{width:100%;border-radius:10px;background:#07140B;box-shadow:inset 0 0 0 2px #000,inset 0 0 18px rgba(80,255,140,.12);padding:12px 8px;font-family:var(--disp);font-size:clamp(11px,1.05vw,15px);color:#8CFFA9;text-shadow:0 0 8px rgba(140,255,169,.8);text-align:center;letter-spacing:.06em;min-height:52px;display:grid;place-items:center}
.led.blink{animation:blink .5s steps(1) infinite}
@keyframes blink{50%{opacity:.25}}
.vbtns{display:grid;gap:10px;width:100%}
.vbtn{display:flex;align-items:center;gap:10px;color:#fff;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-align:left;line-height:1.1}
.vbtn b{flex:0 0 auto;width:clamp(34px,3.4vw,46px);height:clamp(34px,3.4vw,46px);border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.75),var(--c) 45%,var(--cd) 100%);box-shadow:0 4px 0 var(--cd),0 0 0 3px rgba(255,255,255,.08);transition:transform .12s,box-shadow .12s,filter .3s}
.vbtn:hover b{filter:brightness(1.15) drop-shadow(0 0 10px var(--c))}
.vbtn:active b,.vbtn.press b{transform:translateY(4px);box-shadow:0 0 0 var(--cd),0 0 0 3px rgba(255,255,255,.08)}
.vbtn.out{opacity:.35}
.coin{width:14px;height:44px;border-radius:7px;background:#05030A;box-shadow:inset 0 0 0 2px #3A2C55;margin-top:auto}
.vshake{width:100%;padding:12px 6px;border-radius:12px;background:#3A2C55;color:#fff;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;transition:background .3s}
.vshake[disabled]{opacity:.35;pointer-events:none}
.vshake.go{background:var(--g);color:var(--ink);animation:glowp 1s ease-in-out infinite}
@keyframes glowp{50%{box-shadow:0 0 24px var(--g)}}
.vreset{font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.55)}
.vm-chute{grid-column:1;grid-row:3;margin-top:14px;border-radius:12px;background:#07040E;box-shadow:inset 0 8px 16px rgba(0,0,0,.8),inset 0 0 0 2px #3A2C55;position:relative;overflow:hidden;perspective:500px}
.vm-chute .flap{position:absolute;inset:6px;border-radius:8px;background:linear-gradient(180deg,rgba(255,255,255,.14),rgba(255,255,255,.04));transform-origin:50% 0;border:1px solid rgba(255,255,255,.1)}
.vm-chute span{position:absolute;bottom:8px;left:0;right:0;text-align:center;font-size:9px;letter-spacing:.3em;color:rgba(255,255,255,.35);font-weight:600}
.world2{position:absolute;inset:0;z-index:4;pointer-events:none}
#fx2{position:absolute;inset:0;z-index:7;pointer-events:none}
.vm-side,.vm-sign{position:relative;z-index:5}
@media (max-width:1180px) and (min-width:761px){.pack .lead{display:none}.pack .head{max-width:26vw}.pack h2{font-size:3.6vw}.vm{left:60%;width:min(460px,52vw)}}
@media (max-width:900px) and (min-width:761px){.pack .tag{display:none}.pack .head{max-width:30vw}}
@media (max-width:760px){.pack{min-height:740px}.pack .head{top:78px;right:16px;max-width:none}.pack h2{font-size:26px}.pack h2 span{display:inline}.pack .tag{display:none}.vm{left:50%}.pack .lead{display:none}.vm{width:94vw;height:min(64vh,540px);bottom:6%;padding:12px}.vm-side{padding-left:10px;gap:8px}.vbtn span{display:none}.vbtns{justify-items:center}.led{font-size:10px;min-height:44px;padding:8px 4px}}

/* ---------- footer ---------- */
.foot{background:var(--ink);color:var(--cream);padding:12vh clamp(16px,4vw,56px) 5vh;overflow:hidden}
.big{font-family:var(--disp);font-size:12vw;line-height:.86;letter-spacing:-.03em;white-space:nowrap;display:flex;justify-content:center;user-select:none}
.big span{display:inline-block;cursor:default}
.frow{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:8vh;flex-wrap:wrap;font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase}
.frow p{opacity:.6;max-width:40ch;text-transform:none;letter-spacing:0;font-size:15px}
.sig{display:block;width:210px;height:63px;background:var(--cream);-webkit-mask:url(assets/signature.png) center/contain no-repeat;mask:url(assets/signature.png) center/contain no-repeat;clip-path:inset(0 100% 0 0);transition:clip-path 1.8s var(--quint)}
.sig.on{clip-path:inset(0 0 0 0)}

/* ---------- cursor ---------- */
.cur{position:fixed;left:0;top:0;z-index:90;pointer-events:none;width:38px;height:38px;margin:-19px 0 0 -19px;border-radius:50%;border:2px solid var(--ink);background:radial-gradient(circle at 32% 30%,rgba(255,255,255,.9),rgba(255,255,255,.15) 40%,transparent 62%);transition:width .35s var(--expo),height .35s var(--expo),margin .35s var(--expo),border-color .3s;display:none}
.cur.big{width:74px;height:74px;margin:-37px 0 0 -37px}
@media (pointer:fine){.cur{display:block}}

/* ---------- responsive ---------- */
@media (max-width:900px){
  .nav ul{display:none}
}
@media (max-width:760px){
  .story{height:1080vh}
  .canwrap{left:50%;top:36%}
  .canbox{height:46vh}
  .txt{left:20px;right:20px;top:auto;bottom:5vh;transform:none}
  .nm{font-size:clamp(34px,11vw,60px)}
  .sub{font-size:16px}
  .note{font-size:15px;margin-top:1.4vh}
  .meters{margin-top:1.8vh;gap:6px}
  .dots b{width:14px;height:14px}
  .idx{margin-bottom:1.2vh}
  .rail{right:10px;top:84px;transform:none;gap:10px}
  .rail button span{display:none}
  .hero-copy{flex-direction:column;gap:14px}
  .hint{align-items:flex-start}
  .hint span:nth-child(1),.hint span:nth-child(2){display:none}
  .frow{flex-direction:column;align-items:flex-start}
  .glow{display:none}
}
@media (max-height:620px) and (min-width:761px){.meters{display:none}.note{display:none}}
</style>
</head>
<body class="anim">
<div class="pre" id="pre" aria-hidden="true"><div class="liq" id="preLiq"></div><div class="num" id="preNum">0</div><div class="lab">shaking the cans…</div></div>
<div class="cur" id="cur" aria-hidden="true"></div>

<header class="nav" id="nav">
  <a class="logo" href="#top" aria-label="FIZZ RIOT home">FIZZ RIOT <i><b style="background:var(--f1)"></b><b style="background:var(--f2)"></b><b style="background:var(--f3)"></b><b style="background:var(--f4)"></b></i></a>
  <ul><li><a href="#flavours">Flavours</a></li><li><a href="#pack">Build a pack</a></li></ul>
  <span class="chip">4 flavours · 330 ml</span>
</header>

<main id="top">
<section class="hero" id="hero" aria-label="FIZZ RIOT playground">
  <div class="world" id="world" aria-hidden="true"></div>
  <canvas id="fx" aria-hidden="true"></canvas>
  <div class="hero-copy">
    <p><span class="eyebrow">Sparkling soda · Est. 2026</span>Four flavours. Zero chill. A soda that <em>won't sit still</em>.</p>
    <div class="hint"><span><b>↔</b>Drag &amp; throw</span><span><b>●</b>Click to pop</span><span><b>↓</b>Scroll for the riot</span></div>
  </div>
</section>

<section class="story" id="flavours" aria-label="The four flavours">
  <div class="stage" id="stage">
    <nav class="rail" id="rail" aria-label="Jump to flavour"></nav>
  </div>
</section>

<section class="pack" id="pack" aria-label="Riot vending machine">
  <div class="wall"></div><div class="floor"></div>
  <div class="head"><h2><span>Hit a button.</span> <span>Get a riot.</span></h2><p class="lead">Pick any four from the machine. Grab them off the floor, throw them around, then shake the whole thing.</p></div>
  <div class="tag">Per can<b>&euro;2.50</b>4-pack &middot; &euro;9.00</div>
  <div class="vm" id="vm">
    <div class="vm-sign"><span class="neon">FIZZ RIOT</span><i>&#10022;</i></div>
    <div class="vm-win" id="vmwin"></div>
    <div class="vm-side">
      <div class="led" id="led">PICK 4 &middot; 0/4</div>
      <div class="vbtns" id="vbtns"></div>
      <button class="vshake" id="shake" disabled>Shake it</button>
      <button class="vreset" id="clear">Restock</button>
      <div class="coin" aria-hidden="true"></div>
    </div>
    <div class="vm-chute" id="chute" aria-hidden="true"><div class="flap" id="flap"></div><span>PUSH</span></div>
  </div>
  <div class="world2" id="world2" aria-hidden="true"></div>
  <canvas id="fx2" aria-hidden="true"></canvas>
</section>
</main>

<footer class="foot">
  <div class="big" id="big" aria-label="FIZZ RIOT"></div>
  <div class="frow">
    <p>FIZZ RIOT is a concept brand. Every can, splash and slice on this page was shot as video and cut out frame by frame.</p>
    <a href="https://github.com/DexAi3000" target="_blank" rel="noopener" aria-label="Nima Ariyan Far on GitHub"><span class="sig" id="sig"></span></a>
  </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script>
/*JS*/
</script>
</body>
</html>
